# ChangelogSync environment variables
# Copy to .env.local (gitignored) and fill in real values. Local dummy values
# are enough for `bun run build` to pass.

# --- Public (prefixed NEXT_PUBLIC_ are exposed to the browser) ---

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe to ship to the browser; RLS enforces limits)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the app used for redirects/links, e.g. https://app.changelogsync.com
NEXT_PUBLIC_APP_URL=

# --- Server only ---

# Supabase service-role key — server-side admin access, NEVER in the browser
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth App client id (Sign in with GitHub)
GITHUB_CLIENT_ID=

# GitHub OAuth App client secret (server-only)
GITHUB_CLIENT_SECRET=

# Secret configured on the GitHub webhook (used to verify X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# Stripe secret key (sk_live_... / sk_test_...) — server-only
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...) for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Stripe Price ID for the Pro plan, e.g. price_1Qx...
STRIPE_PRO_PRICE_ID=

# OpenAI API key for the AI changelog-summary pipeline
OPENAI_API_KEY=

# --- Tooling ---

# Postgres connection string for `bun run seed` (Supabase pooler), e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=